{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PackageManifest": {
      "type": "object",
      "properties": {
        "packageFormatVersion": {
          "const": 1
        },
        "definitionRef": {
          "$ref": "#/$defs/DefinitionRef"
        },
        "protocolVersion": {
          "const": "1"
        },
        "capabilityProfileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "engineBuildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "worldRuleRef": {
          "$ref": "#/$defs/WorldRef"
        },
        "sourceHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 128
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 128
        },
        "activationSlots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 6
        },
        "origin": {
          "type": "string",
          "enum": [
            "model",
            "fixture"
          ]
        }
      },
      "required": [
        "packageFormatVersion",
        "definitionRef",
        "protocolVersion",
        "capabilityProfileId",
        "engineBuildId",
        "worldRuleRef",
        "sourceHash",
        "files",
        "subscriptions",
        "requiredCapabilities",
        "activationSlots",
        "origin"
      ],
      "additionalProperties": false
    }
  }
}
