{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DefinitionRef": {
      "type": "object",
      "properties": {
        "definitionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "definitionId",
        "version"
      ],
      "additionalProperties": false
    },
    "WorldRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "WorldPosition": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "worldId",
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "Vec3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "maxProperties": 128,
              "additionalProperties": true
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "error"
      ],
      "additionalProperties": false
    },
    "GenerationContext": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string",
          "pattern": "^[a-z0-9_]+:[a-z0-9_./-]+$"
        },
        "biome": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9_]+:[a-z0-9_./-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "$ref": "#/$defs/WorldPosition"
        },
        "worldTimeTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "weather": {
          "type": "object",
          "properties": {
            "worldRain": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "exposedToRain": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "worldRain",
            "exposedToRain"
          ],
          "additionalProperties": false
        },
        "nearbyBlocks": {
          "type": "object",
          "properties": {
            "samplingVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "blockId": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+:[a-z0-9_./-]+$"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "blockId",
                  "count"
                ],
                "additionalProperties": false
              },
              "maxItems": 64
            },
            "missingReason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "samplingVersion",
            "samples",
            "missingReason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dimension",
        "biome",
        "position",
        "worldTimeTicks",
        "weather",
        "nearbyBlocks"
      ],
      "additionalProperties": false
    },
    "CapabilityProfile": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "hostId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "hostBuildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "protocolVersion": {
          "const": "1"
        },
        "engineBuildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 128
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 128
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 128
        },
        "visuals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 128
        },
        "limits": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": true
        }
      },
      "required": [
        "profileId",
        "hostId",
        "hostBuildId",
        "protocolVersion",
        "engineBuildId",
        "events",
        "queries",
        "operations",
        "visuals",
        "limits"
      ],
      "additionalProperties": false
    }
  }
}
