GE_HOST_ID=local-paper
GE_PORT=8765
# 本机生成服务与插件共用的随机令牌，至少 32 字符。
GE_INTERNAL_TOKEN=
GE_DATA_DIR=var/generator
GE_WORLDS_DIR=worlds
# 阿里云 OpenAI-compatible 接口；密钥只由生成服务使用。
GE_ALIYUN_API_KEY=
GE_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GE_ALIYUN_MODEL=deepseek-v4.1-flash-1017
# 思考 token 也计费；不支持 reasoning_effort 的模型可将该变量留空。
GE_ALIYUN_ENABLE_THINKING=true
GE_ALIYUN_REASONING_EFFORT=low
GE_ALIYUN_MAX_TOKENS=16384
GE_ALIYUN_TIMEOUT_MS=180000
# dev:generator 自动选择项目使用的 Java；生产部署可填写绝对路径。
# GE_JAVA_COMMAND=/path/to/java
# GE_VALIDATOR_JAR=/path/to/validator-cli.jar
